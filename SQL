-- tbl_laundry_type tlt  /TBL_laundry_SERVICE tls  /TBL_laundry_RECEIPT tlr
-- 서비스코드, 서비스명, 세탁종류, 기본요금 
select SERVICE_CODE 서비스코드, SERVICE_NAME 서비스명, type_name 세탁종류, UNIT_PRICE 기본요금
from TBL_laundry_SERVICE tls left outer join tbl_laundry_type tlt
on tls.type_code = tlt.type_code;


-- 접수일자, 접수번호, 서비스명, 세탁종류, 기본요금, 접수금액, 고객명
select RECEIPT_date 접수일자,RECEIPT_NO 접수번호, SERVICE_NAME 서비스명, type_name 세탁종류, UNIT_PRICE 기본요금,
sum(UNIT_PRICE*item_qty) 접수금액, customer_name 고객명
from TBL_laundry_RECEIPT tlr left outer join TBL_laundry_SERVICE tls 
on tlr.service_code = tls.service_code left outer join tbl_laundry_type tlt
on tls.type_code = tlt.type_code
group by RECEIPT_date,RECEIPT_NO
order by RECEIPT_date,RECEIPT_NO asc;

-- 종류코드, 세탁종류, 접수건수, 총접수수량, 총매출금액
select 	tlt.type_code 종류코드, tlt.type_name 세탁종류, COUNT(item_qty) 접수건수, SUM(item_qty) 접수수량, sum(UNIT_PRICE*item_qty) 총매출
FROM tbl_laundry_type tlt LEFT OUTER JOIN TBL_laundry_SERVICE tls 
ON tls.type_code = tlt.type_code LEFT OUTER JOIN TBL_laundry_RECEIPT tlr
ON tlr.service_code = tls.service_code
GROUP BY tlt.type_code, tlt.type_name  WITH ROLLUP;

select 	tlt.type_code 종류코드, tlt.type_name 세탁종류, COUNT(item_qty) 접수건수, SUM(item_qty) 접수수량, sum(UNIT_PRICE*item_qty) 총매출
FROM tbl_laundry_type tlt LEFT OUTER JOIN TBL_laundry_SERVICE tls 
ON tls.type_code = tlt.type_code LEFT OUTER JOIN TBL_laundry_RECEIPT tlr
ON tlr.service_code = tls.service_code
group by tlt.type_code, tlt.type_name;
