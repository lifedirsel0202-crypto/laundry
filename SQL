CREATE TABLE TBL_laundry_SERVICE(
SERVICE_CODE CHAR(5) NOT NULL PRIMARY KEY,
SERVICE_NAME VARCHAR(30) NOT NULL,
TYPE_CODE CHAR(2) NOT NULL,
UNIT_PRICE INT(8) NOT NULL,
FOREIGN KEY(TYPE_CODE) REFERENCES tbl_laundry_type(type_code));

