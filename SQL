CREATE TABLE TBL_laundry_RECEIPT(
RECEIPT_NO CHAR(5) NOT NULL PRIMARY KEY,
RECEIPT_DATE CHAR(8) NOT NULL,
SERVICE_CODE CHAR(5) NOT NULL,
ITEM_QTY INT(2) CHECK(ITEM_QTY BETWEEN 1 AND 10) NOT NULL,
